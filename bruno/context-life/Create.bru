meta {
  name: Create Context Life
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/context-life
  body: json
  auth: none
}

body:json {
  {
    "title": "New job",
    "description": "Started a new job this month, still adjusting."
  }
}

script:post-response {
  if (res.body && res.body._id) {
    bru.setEnvVar("contextLifeId", res.body._id);
  }
}
